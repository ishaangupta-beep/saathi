# Saathi configuration. Copy this file to `.env` (same folder) and fill it in.
# `.env` is git-ignored, so your keys never get committed.

# ── Model provider (any OpenAI-compatible endpoint) ──────────────────────────
# Final submission: Nebius Token Factory (required by the hackathon rules)
# PROVIDER_BASE_URL=https://api.tokenfactory.nebius.com/v1
#
# Free testing while you decide on a card: OpenRouter's free Nemotron models
PROVIDER_BASE_URL=https://openrouter.ai/api/v1
PROVIDER_API_KEY=

# Leave these blank to auto-pick Nemotron models from the provider's model list.
# Set them only if auto-pick chooses the wrong one (check the app's routing window).
VISION_MODEL=
REASONING_MODEL=
FAST_MODEL=

# Hard stop: Saathi refuses model calls once its estimated spend reaches this (USD).
SPEND_LIMIT_USD=15

# ── Tavily (optional: official-steps research + lookalike-site check) ────────
TAVILY_API_KEY=
